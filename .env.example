# ===================== ATHENA — config (paper de medição) =====================
# Copie para `.env` e preencha as senhas. O `.env` é gitignored (não versionado);
# este arquivo (.env.example) é o template versionado — mantenha-o completo.

# --- BRAÇO / MODO (gire na matriz) ---
MODEL_FAMILY=qwen-reasoning
#   qwen-reasoning → qwen3:8b              (Qwen3,   reasoning)  ← mais capaz, comece aqui
#   deepseek       → deepseek-r1:8b        (Qwen3,   reasoning)  ← LENTO ~25min, rode em background
#   deepseek-llama → r1:8b-llama-distill   (Llama,   reasoning)  [OPCIONAL — desinstalado; re-pull se for usar a célula Llama-reasoning]
#   phi            → phi4-mini-reasoning   (Phi-4,   reasoning, fraco)
#   llama          → llama3.1:8b           (Llama,   NÃO-reasoning) ← contraste
#   mistral        → mistral:7b-instruct   (Mistral, NÃO-reasoning) ← contraste
APPLY_HEURISTICS=off            # off = UNAIDED (capacidade crua) | on = GUIADO (hint-B injetado)
DISABLE_SEMANTIC_CACHE=on       # ⚠️ COLD — obrigatório na matriz (senão run 2/3 bate cache e pula o modelo)
DISCOVERY_MODE=on               # on = habilita o eixo de índice (advisor → simula → registra)
TEACHER_MODEL_FAMILY=qwen-reasoning   # professor que escreve o hint-B (braço guiado) — FIXO, não gira

# --- REASONING (eixo controlado do FIND) ---
REASONING=off       # on=+think (gera <think> CoT, delibera) | off=+nothink (direto) | unset=default do modelo.
                    #   NÃO tira <think> pós-hoc — é o modelo não pensar (ollama think:false). Só afeta modelos
                    #   com thinking (qwen3/deepseek-r1); INÓCUO em mistral/llama (não-reasoning). Vira label +think/+nothink.

# --- MODO DO PIPELINE + WRITER + STORE (⚠️ PAREAR modo↔store) ---
TWO_AGENT_MODE=off  # off=RAW (1 agente: architect ESCREVE o SQL) | on=2-AGENTES (architect DECIDE estratégia → writer ESCREVE)
WRITER_BACKEND=local            # no 2-agentes: local (=PRODUTO, light/local) | cloud (=TETO/oráculo, quebra "local", SÓ dado PÚBLICO)
FIND_BACKEND=local              # CEILING: o FIND (architect) roda local (qwen) | cloud (deepseek-reasoner = TETO de FIND) → label +cloudfind
                                #   mede quanto do teto do 8B é capacidade do FIND × sem-oportunidade. Quebra "leve/local" = só medição, dado PÚBLICO
CLOUD_FIND_MODEL=deepseek-reasoner  # modelo cloud do FIND quando FIND_BACKEND=cloud (R1, CoT nativo). alt: deepseek-chat (não-reasoning)
LOCAL_CODER_MODEL=qwen2.5-coder:7b   # writer local (produto). Controle cross-família: deepseek-coder:6.7b
CLOUD_CODER_MODEL=deepseek-chat      # writer cloud (teto)
CLOUD_CODER_API_BASE=https://api.deepseek.com
KEY_DEEPSEEK=<your-deepseek-api-key> # só p/ WRITER_BACKEND=cloud (dado PÚBLICO!). .env é gitignored.
CORRECTOR_ENABLED=off           # RAW: on = corretor-fallback B1 (patcheia botch mecânico) | off = raw puro
# STORE — PAREAR com o modo (não misturar raw e aided no mesmo store):
RUN_ARM=raw                     # raw | aided (rótulo do store)
SUGGESTION_STORE_DIR=.cache/suggestions             # raw=.cache/suggestions | aided=.cache/suggestions_aided
INDEX_SUGGESTION_STORE_DIR=.cache/index_suggestions # idem índice: aided=.cache/index_suggestions_aided
# ⚠️ CAP do rolling-buffer POR store dir. ERA 500 e EVICTAVA dados de MEDIÇÃO (perdeu a célula qwen/PG uma vez).
#   100k = efetivamente SEM eviction (a matriz toda ~10-15k). NÃO baixar. NÃO recupera o já apagado.
SUGGESTION_STORE_MAX_RECORDS=100000

# --- LEVERS / EIXOS DE MEDIÇÃO (A/B: flipe UM, mesmo resto; cada um vira label distinto) ---
# FIND — ablação de contexto (mede o que cada camada adiciona; ver doutorado_next_steps §4.9):
HW_HINTS=on                     # off = tira hardware do prompt (ablação) → label +nohw
PLAN_HINTS=on                   # off = tira o PLANO de execução (otimiza só por estrutura+schema) → label +noplan
# WRITE-fix — só atuam no 2-agentes (ou CORRECTOR_ENABLED=on):
SCHEMA_LINKING=off              # on = colunas reais + JOIN KEYS (FKs) no prompt de quem ESCREVE: coder (aided) + raw architect (B-write) → label +schemalink
SCHEMA_LINKING_FIND=off         # B-find: colunas reais no prompt de DECISÃO do architect (o FIND, não o WRITE) → o FIND mira melhor coluna/chave → label +schemafind. Isolado pra medir separado do WRITE
WRITER_LINT=off                 # on = linter de auto-consistência (CTE-fantasma/coluna-fora-de-escopo/ambígua) pré-execução
WRITER_LINT_MAX=2               # nº de re-tentativas internas do lint
RICH_EQUIVALENCE_FEEDBACK=off   # on = diff de linhas no S≠1 (priv-safe: contagem/forma, nunca valor) → label +richfb
DIALECT_HINTS=off               # lever D (alvo: mechanics_failed). ≠ syntax_hint(), que é parity de BASELINE e vai em TODOS
                                #   os braços. TRÊS valores:
                                #   off      = nada
                                #   on       = REATIVO (degrau 2) — injeta só a regra cuja assinatura de erro o SGBD acabou
                                #              de emitir (1055/1584/1064/1176). Gatilho = engine, não a nossa amostra. Sem
                                #              erro (1ª tentativa) não injeta nada → label +dialecthints
                                #   blanket  = TETO (degrau 1) — todas as regras sempre. ⚠️ ENVIESADO por construção (a lista
                                #              saiu dos erros destas 21 queries). Mede "dialeto vale algo?", NÃO é implantável
                                #              → label +dialectall
                                #   produção de verdade = degrau 3: RAG sobre a doc oficial do SGBD ([1c]), cobre erro inédito
SEMANTIC_GUARD=off              # lever SEM: checklist de PRESERVAÇÃO no writer → label +semguard. Alvo: equivalence_failed
                                #   ESCOPO DELIBERADO = só "não introduza LIMIT em escopo interno". Os outros modos medidos
                                #   (predicado na ocorrência errada de tabela reusada / OR→UNION ALL) ficaram DE FORA: a
                                #   auditoria de adherence deu 12/12 ADHERENT nos equiv-fail, e as ESTRATÉGIAS do architect
                                #   prescreviam a transformação que quebrou → mandar o coder desobedecer contaminaria a
                                #   medição do FIND do modelo leve (a claim do Paper 1). Esses ficam como limite MEDIDO do FIND
TRUE_FAILURE_FEEDBACK=off       # bug #18 / lever de minimal-reasoning-efficiency → label +truefb. Na RE-ESTRATÉGIA, diz ao
                                #   architect a CLASSE REAL do fracasso anterior (S≠1 = "sua estratégia não preserva
                                #   equivalência" × "não deu p/ escrever" × "sem ganho") em vez de colapsar tudo em
                                #   "could not be written" — que fazia o architect culpar o CODER por erro DELE.
                                #   OFF por padrão: ligar torna a run incomparável com a matriz já rodada (PG + MySQL M1..M3-A)
SEMANTIC_PRECHECK=off           # pré-check formal [4]: compara ORIGINAL × reescrita e barra a não-equivalência ANTES de
                                #   executar (reusa o loop bounded do WRITER_LINT) → label +precheck. Lever de EFICIÊNCIA:
                                #   validado offline em 126 runs = 7/17 equiv-fail pegos, ZERO falso-positivo nos 21 lands.
                                #   ⚠️ confunde com SEMANTIC_GUARD (mesmo bucket) — não ligar os dois no mesmo A/B
WRITER_ADHERENCE_CHECK=off      # on = juiz LLM local audita se o writer seguiu a TÉCNICA do architect → adherence.verdict no store
# Índice:
INDEX_WORKLOAD_AWARE=off        # on = a LLM vê o workload ao recomendar índice (Form 2 vs Form 1 per-query)
# #12 validated-strategy cache (só atua no 2-agentes) — reusa estratégias VALIDADAS por FORMA (assinatura AST),
#   pula o reasoning quando a forma casa, mas SEMPRE re-valida (S=1+ganho). Peça de EFICIÊNCIA/auto-melhoria do P2.
STRATEGY_CACHE=off              # on = lookup+bypass (forma casa → reusa + pula reasoning) | off = baseline cold (raciocina sempre)
STRATEGY_CACHE_PERSIST=off      # on = auto-persiste land fresco + reforça/rebaixa hit | off = CONGELA (held-out: monta no set A, testa no B)
STRATEGY_CACHE_DIR=.cache/strategy_cache  # onde o cache vive (assinatura+estratégia+ganho por técnica×forma)

# --- Tags dos modelos (default em src/connections.py FAMILIES; sobrescreva se necessário) ---
QWEN_REASONING_MODEL=qwen3:8b
QWEN_MODEL=qwen2.5:7b
DEEPSEEK_MODEL=deepseek-r1:8b
DEEPSEEK_LLAMA_MODEL=deepseek-r1:8b-llama-distill-q4_K_M
LLAMA_MODEL=llama3.1:8b
MISTRAL_MODEL=mistral:7b-instruct
PHI_MODEL=phi4-mini-reasoning
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# --- ENGINE + BENCHMARK ---
# TPC-DS e JOB/IMDb são bancos SEPARADOS (portas distintas). O runner detecta o benchmark pelo DB_URI.
# Troque o par (DB_URI + VERIFY_DB_URI + DB_TYPE) conforme a conexão e REINICIE o servidor.
DB_TYPE=postgres                # postgres | mysql | (sql/neo4j/mongo p/ outros builders)

# >>> TPC-DS PostgreSQL (ativo por padrão):
DB_URI=postgresql://postgres:<password>@localhost:5435/tpcds
VERIFY_DB_URI=postgresql://postgres:<password>@localhost:5437/tpcds   # instância SF1 (~2% da fato) p/ S=1 sob timeout
# >>> TPC-DS MySQL:    DB_URI=mysql+pymysql://root:<password>@localhost:3308/tpcds  | VERIFY_DB_URI=...:3309/tpcds | DB_TYPE=mysql
# >>> IMDb/JOB PG:     DB_URI=postgresql://postgres:<password>@localhost:5436/imdb  | (sem VERIFY_DB_URI)         | DB_TYPE=postgres
# >>> IMDb/JOB MySQL:  DB_URI=mysql+pymysql://root:<password>@localhost:3307/imdb   | DB_TYPE=mysql

# --- Timeouts (segundos) ---
ARCHITECT_TIMEOUT_S=450           # deadline de UMA chamada do architect (corta CoT runaway; 0 = sem limite).
                                  #   normal ~85-150s, runaway ~2000s → 450 mata o runaway e SALVA o <think> parcial
                                  #   (outcome="timeout", classe-c). Distinto do --timeout do runner (a query INTEIRA).
SAMPLE_HASH_TIMEOUT_S=120         # budget do hash de equivalência (LIMIT 100) na escala cheia
EXPLAIN_ANALYZE_TIMEOUT_S=120     # budget do EXPLAIN ANALYZE (piso de tempo do original)
OPTIMIZED_FAST_TIMEOUT_S=120      # budget curto no otimizado quando o original deu timeout
VERIFY_SAMPLE_HASH_TIMEOUT_S=60   # budget do hash na instância de verificação SF1

# --- Neo4j (futuro — descomente quando exercitar o backend de grafo) ---
# DB_TYPE=neo4j
# DB_URI=bolt://localhost:7687
# DB_USER=neo4j
# DB_PASSWORD=<password>
